model M driver EMF {nsuri="http://www.eclipse.org/emf/2002/Ecore"};

pre {
	var maxFeatures = 10;
	var wrong : Integer = "ten";
}

context EClass {
	constraint NotTooManyFeatures {
		check : 1
	}
}

post {
	var alsoWrong : String = 1;
}

