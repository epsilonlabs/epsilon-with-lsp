model M driver EMF {nsuri="http://www.eclipse.org/emf/2002/Ecore"};

var c : EClassifier;

var p : EPackage;

/*OrderedSet<EClassifier>*/p.eClassifiers;

p.eClassifiers.add(p); // Should raise an error as an EPackage cannot be added to eClassifiers

p.eClassifiers.first().ePackage = c; // Should raise an error due to type incompatibility

var n : ENamedElement;
var e : EClass;

// Looking an element up only requires it to be related to EClassifier
p.eClassifiers.remove(p);
p.eClassifiers.remove(n);
p.eClassifiers.remove(e);
p.eClassifiers.includes(p);
p.eClassifiers.indexOf(e);

// Storing an element requires it to be assignable to EClassifier
p.eClassifiers.including(e);
p.eClassifiers.including(p);

