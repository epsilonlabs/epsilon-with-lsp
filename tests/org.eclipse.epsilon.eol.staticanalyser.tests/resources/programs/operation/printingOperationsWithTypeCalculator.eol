/*String*/ "s".print();
/*String*/ "s".print("prefix");
/*String*/ "s".print("prefix", "suffix");

/*Integer*/ 1.println();
/*Integer*/ 1.println("prefix");
/*Integer*/ 1.println("prefix", "suffix");

/*Real*/ 1.1.err();
/*Real*/ 1.1.err("prefix");
/*Real*/ 1.1.err("prefix", "suffix");

