var ints : Sequence<Integer> = Sequence{1, 2, 3};
var strings : Sequence<String> = Sequence{"a"};
var reals : Sequence<Real>;
var anything : Sequence<Any>;
var intSet : Set<Integer>;
var tasks : Sequence<Task>;

// Operations that store their argument require it to be assignable to the contained type
ints.add(4);
ints.add("a");
ints.add(0, 5);
ints.add(0, "a");
ints.set(0, "a");
ints.addAll(Sequence{4, 5});
ints.addAll(strings);
ints.addAll(0, strings);
ints.including("a");
ints.includingAll(strings);
reals.add(1);
anything.add("a");
anything.addAll(strings);
ints.addFirst(0);
ints.addFirst("a");
ints.addLast(4);
ints.addLast("a");

// Operations that look their argument up only require it to be related to the contained type
ints.remove("a");
ints.contains("a");
ints.includes("a");
ints.excludes("a");
ints.count("a");
ints.indexOf("a");
ints.lastIndexOf("a");
ints.excluding("a");
ints.removeAll(strings);
ints.retainAll(strings);
ints.containsAll(strings);
ints.includesAll(strings);
ints.excludesAll(strings);
ints.excludingAll(strings);
intSet.remove("a");
intSet.indexOf("a");
reals.includes(1);
ints.includes(1.5);
ints.remove(1);
ints.includesAll(Sequence{1, 2});
anything.includes("a");
strings.includes(anything.first());
tasks.includes("a");

