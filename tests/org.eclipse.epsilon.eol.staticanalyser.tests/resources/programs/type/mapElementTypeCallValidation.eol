var m : Map<String, Integer>;
var untyped : Map;

// Operations that store their arguments require them to be assignable to the key and value types
m.put("a", 1);
m.put(1, 1);
m.put("a", "b");
m.put(1, "b");
m.putIfAbsent("a", "b");
m.replace("a", "b");
m.replace("a", 1, "b");
m.putAll(Map{"a" = 1});
m.putAll(Map{1 = 1});
untyped.put(1, "a");

// Operations that look their argument up only require it to be related to the key or value type
m.get("a");
m.get(1);
m.containsKey(1);
m.containsValue("a");
m.remove(1);
m.remove(1, 1);
m.getOrDefault(1, 0);
untyped.get(1);
Map{"a" = 1, 2 = 3}.get(1);
Map{"a" = 1, 2 = 3}.get(true);

